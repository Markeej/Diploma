	  </MauiXaml>
	  <MauiXaml Update="Views\SledenjeZivaliPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\ZdravilaPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
