<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="E_zivali.Views.CepljenjaPage"
    Title="Cepljenja">

    <Grid
        Padding="20"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="15">

        <!-- NASLOV -->
        <VerticalStackLayout Grid.Row="0">

            <Label
                Text="Cepljenja"
                FontSize="26"
                FontAttributes="Bold"/>

            <Label
                x:Name="ImeZivaliLabel"
                FontSize="16"
                TextColor="Gray"/>

        </VerticalStackLayout>


        <!-- SEZNAM CEPLJENJ -->
        <CollectionView
            x:Name="CepljenjaCollectionView"
            Grid.Row="1"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="5">

                    <Label
                        Text="Ni dodanih cepljenj."
                        FontSize="18"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Dodajte prvo cepljenje za to žival."
                        TextColor="Gray"
                        HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>

            </CollectionView.EmptyView>


            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Padding="15"
                        Margin="0,5"
                        Stroke="#DDDDDD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10">

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="{Binding Naziv}"
                                FontSize="18"
                                FontAttributes="Bold"/>

                            <Label
                                Text="{Binding DatumCepljenja,
                                StringFormat='Datum: {0:dd.MM.yyyy}'}"/>

                            <Label
                                Text="{Binding NaslednjeCepljenje,
                                StringFormat='Naslednje cepljenje: {0:dd.MM.yyyy}'}"/>

                            <Label
                                Text="{Binding Veterinar,
                                StringFormat='Veterinar: {0}'}"/>

                            <Label
                                Text="{Binding Opombe}"
                                TextColor="Gray"/>


                            <!-- UREDI / IZBRIŠI -->
                            <HorizontalStackLayout
                                Spacing="10"
                                Margin="0,10,0,0">

                                <Button
                                    Text="Uredi"
                                    Clicked="UrediCepljenjeKlik"
                                    CommandParameter="{Binding .}"/>

                                <Button
                                    Text="Izbriši"
                                    Clicked="IzbrisiCepljenjeKlik"
                                    CommandParameter="{Binding .}"/>

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>


        <!-- DODAJ -->
        <Button
            Grid.Row="2"
            Text="+ Dodaj cepljenje"
            Clicked="DodajCepljenjeKlik"/>

    </Grid>

</ContentPage>