<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="E_zivali.Views.DokumentiZivaliPage"
    Title="Dokumenti">

    <Grid
        Padding="20"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="15">

        <VerticalStackLayout Grid.Row="0">

            <Label
                Text="Dokumenti"
                FontSize="26"
                FontAttributes="Bold"/>

            <Label
                x:Name="ImeZivaliLabel"
                FontSize="16"
                TextColor="Gray"/>

        </VerticalStackLayout>

        <CollectionView
            x:Name="DokumentiCollectionView"
            Grid.Row="1"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center">

                    <Label
                        Text="Ni dodanih dokumentov."
                        FontSize="18"/>

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Padding="15"
                        Margin="0,5"
                        Stroke="#DDDDDD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10">

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="{Binding Naziv}"
                                FontSize="18"
                                FontAttributes="Bold"/>

                            <Label
                                Text="{Binding Vrsta,
                                StringFormat='Vrsta: {0}'}"/>

                            <Label
                                Text="{Binding Datum,
                                StringFormat='Datum: {0:dd.MM.yyyy}'}"/>

                            <Label
                                Text="{Binding ImeDatoteke}"
                                TextColor="Gray"/>

                            <Button
                                Text="Odpri dokument"
                                Clicked="OdpriDokumentKlik"
                                CommandParameter="{Binding .}"/>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button
            Grid.Row="2"
            Text="+ Dodaj dokument"
            Clicked="DodajDokumentKlik"/>

    </Grid>

</ContentPage>