<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="E_zivali.Views.DodajPregledPage"
    Title="Dodaj pregled">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="12">

            <Label
                Text="Dodaj veterinarski pregled"
                FontSize="26"
                FontAttributes="Bold"/>

            <Label
                x:Name="ImeZivaliLabel"
                TextColor="Gray"/>


            <Label Text="Datum pregleda"/>

            <DatePicker
                x:Name="DatumPregledaVnos"/>


            <Label Text="Razlog obiska"/>

            <Entry
                x:Name="RazlogVnos"
                Placeholder="npr. Redni pregled"/>


            <Label Text="Diagnoza"/>

            <Entry
                x:Name="DiagnozaVnos"
                Placeholder="Vnesite diagnozo"/>


            <Label Text="Veterinar"/>

            <Entry
                x:Name="VeterinarVnos"
                Placeholder="Ime veterinarja ali ambulante"/>


            <Label Text="Opombe"/>

            <Editor
                x:Name="OpombeVnos"
                Placeholder="Dodatne opombe"
                HeightRequest="120"/>


            <Button
                Text="Shrani pregled"
                Clicked="ShraniPregledKlik"
                Margin="0,15,0,0"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>