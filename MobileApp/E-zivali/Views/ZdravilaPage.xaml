<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="E_zivali.Views.ZdravilaPage"
    Title="Zdravila">

    <Grid
        Padding="20"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="15">

        <VerticalStackLayout Grid.Row="0">

            <Label
                Text="Zdravila in terapije"
                FontSize="26"
                FontAttributes="Bold"/>

            <Label
                x:Name="ImeZivaliLabel"
                TextColor="Gray"/>

        </VerticalStackLayout>

        <CollectionView
            x:Name="ZdravilaCollectionView"
            Grid.Row="1"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <Label
                    Text="Ni dodanih zdravil."
                    FontSize="18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Padding="15"
                        Margin="0,5"
                        Stroke="#DDDDDD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10">

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="{Binding Naziv}"
                                FontSize="18"
                                FontAttributes="Bold"/>

                            <Label
                                Text="{Binding Odmerek,
                                StringFormat='Odmerek: {0}'}"/>

                            <Label
                                Text="{Binding Pogostost,
                                StringFormat='Pogostost: {0}'}"/>

                            <Label
                                Text="{Binding DatumZacetka,
                                StringFormat='Začetek: {0:dd.MM.yyyy}'}"/>

                            <Label
                                Text="{Binding DatumKonca,
                                StringFormat='Konec: {0:dd.MM.yyyy}'}"/>

                            <Label
                                Text="{Binding Veterinar,
                                StringFormat='Veterinar: {0}'}"/>

                            <Label
                                Text="{Binding Opombe}"
                                TextColor="Gray"/>

                            <HorizontalStackLayout
                                Spacing="10"
                                Margin="0,10,0,0">

                                <Button
                                    Text="Uredi"
                                    Clicked="UrediZdraviloKlik"
                                    CommandParameter="{Binding .}"/>

                                <Button
                                    Text="Izbriši"
                                    Clicked="IzbrisiZdraviloKlik"
                                    CommandParameter="{Binding .}"/>

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button
            Grid.Row="2"
            Text="+ Dodaj zdravilo"
            Clicked="DodajZdraviloKlik"/>

    </Grid>

</ContentPage>