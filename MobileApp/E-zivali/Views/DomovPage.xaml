<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="E_zivali.Views.DomovPage"
             Title="Domov">
    
    <VerticalStackLayout
    Padding="30"
    Spacing="20"
    VerticalOptions="Center">


        <Image
        Source="e_zivali.png"
        HeightRequest="200"
        HorizontalOptions="Center"
            Margin="0,0,0,40"/>

        <Label x:Name="PozdravLabel" Text="Pozdravljen!" FontSize="16" FontAttributes="Bold"/>

        <Button Text="Moje živali" Clicked="OnMojeZivali"></Button>
        <Button Text="Opomniki" Clicked="OnOpomnikiClicked"></Button>
    </VerticalStackLayout>
    
</ContentPage>