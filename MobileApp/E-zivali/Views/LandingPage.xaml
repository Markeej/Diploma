    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="E_zivali.Views.LandingPage"
    Title="Naslovna stran"
    BackgroundColor="White">

    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">

        <Image
            
            Source="e_zivali.png"
