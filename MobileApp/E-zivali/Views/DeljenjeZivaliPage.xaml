<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="E_zivali.Views.DeljenjeZivaliPage"
    Title="Deljenje dostopa">

    <VerticalStackLayout
        Padding="20"
        Spacing="15">

        <Label
            Text="Deljenje dostopa"
            FontSize="26"
            FontAttributes="Bold"/>

        <Label
            x:Name="ImeZivaliLabel"
            TextColor="Gray"/>

        <Label
            Text="Moja koda za deljenje"
            FontAttributes="Bold"/>

        <HorizontalStackLayout Spacing="10">

            <Label
                x:Name="MojaShareCodeLabel"
                Text="Nalagam..."
                FontSize="18"
                VerticalOptions="Center"/>

            <Button
                Text="Kopiraj"
                Clicked="KopirajShareCodeKlik"/>

        </HorizontalStackLayout>

        <BoxView HeightRequest="1"/>

        <Label
            Text="Koda uporabnika, s katerim želite deliti dostop"/>

        <Entry
            x:Name="ShareCodeVnos"
            Placeholder="PET-XXXXXX"/>

        <Button
            Text="Deli dostop"
            Clicked="DeliDostopKlik"/>

    </VerticalStackLayout>

</ContentPage>