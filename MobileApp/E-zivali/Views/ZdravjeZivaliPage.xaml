<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="E_zivali.Views.ZdravjeZivaliPage"
             Title="Zdravje Zivali">
    <VerticalStackLayout Spacing="30" Margin="100">

        <Image
          Source="e_zivali.png"
          HeightRequest="150"
          HorizontalOptions="Center"
              Margin="0,0,0,40"/>
        
        <Button Text="Cepljenja" WidthRequest="150" HorizontalOptions="Center" Clicked="OnCepljenjaClicked"></Button>
        <Button Text="Veterinarski pregledi" WidthRequest="150" HorizontalOptions="Center" Clicked="OnPreglediClicked"></Button>
        <Button Text="Zdravila" WidthRequest="150" HorizontalOptions="Center" Clicked="OnZdravilaClicked"></Button>


    </VerticalStackLayout>
</ContentPage>